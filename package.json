{
  "name": "@tcgdata/tcgdex-offline",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./db/asia": {
      "types": "./dist/db/asia/index.d.mts",
      "default": "./dist/db/asia/index.mjs"
    },
    "./db/international": {
      "types": "./dist/db/international/index.d.mts",
      "default": "./dist/db/international/index.mjs"
    }
  },
  "sideEffects": false,
  "repository": {
    "url": "https://github.com/tcgdata/tcgdex-offline"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && tsdown",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --max-warnings=0 --fix",
    "prettier": "npx prettier -c .",
    "prettier:fix": "npx prettier -w .",
    "test": "vitest run",
    "update-db": "tsx ./scripts/update-db.ts",
    "delete-stale-changesets": "tsx ./scripts/delete-stale-changesets.ts"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "execa": "^10.0.1",
    "glob": "^13.0.6",
    "prettier": "^3.9.6",
    "sanitize-filename": "^1.6.4",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "unplugin-ast": "^0.18.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "zod": "^4.5.4"
  }
}
